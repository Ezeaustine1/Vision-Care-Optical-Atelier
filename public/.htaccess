<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header to PHP scripts on cPanel / Apache CGI / FastCGI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route all /api/* requests to the PHP backend router (/api/index.php)
  RewriteCond %{REQUEST_URI} (^|/)api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(?:.*/)?api/(.*)$ api/index.php [QSA,L]

  # Serve existing static files (images, CSS, JS, fonts) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other frontend URLs to the React SPA entry point (index.html)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Security: Prevent directory listing and protect .env files if present
Options -Indexes
<FilesMatch "^\.env">
  Order allow,deny
  Deny from all
</FilesMatch>
